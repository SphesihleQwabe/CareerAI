# =============================
# CareerAI .gitignore
# =============================

# Composer dependencies (regenerated by: composer install)
/vendor/

# Environment variables (contains Gmail App Password and other secrets)
.env

# User-uploaded files (do not push private user data to GitHub)
/uploads/*
!/uploads/.gitkeep

# OS and editor files
Thumbs.db
.DS_Store
.vscode/
.idea/

# Log files
*.log